{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/snapshot-songs.mjs",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/hanetz",
      "destination": "/hanetz/index.html"
    },
    {
      "source": "/hanetz/",
      "destination": "/hanetz/index.html"
    },
    {
      "source": "/hanetz/map",
      "destination": "/hanetz/map/index.html"
    },
    {
      "source": "/hanetz/map/",
      "destination": "/hanetz/map/index.html"
    },
    {
      "source": "/hanetz/explore",
      "destination": "/hanetz/explore/index.html"
    },
    {
      "source": "/hanetz/explore/",
      "destination": "/hanetz/explore/index.html"
    },
    {
      "source": "/listen",
      "destination": "/index.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/upload",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/your-song",
      "destination": "/your-song.html"
    },
    {
      "source": "/your-song/ideas",
      "destination": "/your-song-ideas.html"
    },
    {
      "source": "/artist/:handle([^/.]+)",
      "destination": "/index.html"
    },
    {
      "source": "/artist/:handle([^/.]+)/",
      "destination": "/index.html"
    },
    {
      "source": "/song/:slug([^/.]+)",
      "destination": "/index.html"
    },
    {
      "source": "/song/:slug([^/.]+)/",
      "destination": "/index.html"
    },
    {
      "source": "/d/:code([^/.]+)",
      "destination": "/index.html"
    },
    {
      "source": "/d/:code([^/.]+)/",
      "destination": "/index.html"
    },
    {
      "source": "/u/:handle([^/.]+)",
      "destination": "/index.html"
    },
    {
      "source": "/u/:handle([^/.]+)/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/hanetz",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/hanetz/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
